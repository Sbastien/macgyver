#!/usr/bin/env bash
#
# Generate the root Brewfile from profiles/.
#
# The root Brewfile is a build artifact. It stays committed so the one-line
# installer and the website can keep reading a single well-known file, but it
# is never edited by hand: edit profiles/*.Brewfile and regenerate.
#
# Usage:
#   bin/generate            write the root Brewfile
#   bin/generate --check    exit non-zero if the root Brewfile is out of date

set -euo pipefail

readonly OUTPUT="Brewfile"

# Profiles concatenated into the root Brewfile, in order. Only `base` is
# included: the public one-line install should give a sane baseline, not one
# person's work and personal machines. The other profiles are installed on
# top with `mise run install:work` and friends.
readonly ROOT_PROFILES=("base")

render() {
    printf '# Generated by bin/generate — do not edit.\n'
    printf '#\n'
    printf '# Built from:'
    printf ' profiles/%s.Brewfile' "${ROOT_PROFILES[@]}"
    printf '\n'
    printf '# Edit those, then run: mise run generate\n'
    printf '\n'

    local profile
    for profile in "${ROOT_PROFILES[@]}"; do
        if [[ ! -f "profiles/${profile}.Brewfile" ]]; then
            printf 'profiles/%s.Brewfile not found\n' "$profile" >&2
            exit 1
        fi
        cat "profiles/${profile}.Brewfile"
    done
}

if [[ "${1:-}" == "--check" ]]; then
    if [[ ! -f "$OUTPUT" ]]; then
        printf '  \033[31m✗\033[0m %s is missing. Run: mise run generate\n' "$OUTPUT" >&2
        exit 1
    fi

    if diff -q <(render) "$OUTPUT" >/dev/null 2>&1; then
        printf '  \033[32m✓\033[0m %s is up to date\n' "$OUTPUT"
        exit 0
    fi

    message="$OUTPUT is out of date with profiles/. Run: mise run generate"
    [[ -n "${GITHUB_ACTIONS:-}" ]] && printf '::error::%s\n' "$message"
    printf '  \033[31m✗\033[0m %s\n\n' "$message" >&2
    diff -u "$OUTPUT" <(render) | sed 's/^/    /' >&2
    exit 1
fi

render >"$OUTPUT"
printf '  \033[32m✓\033[0m wrote %s from %s\n' "$OUTPUT" "${ROOT_PROFILES[*]}"
